{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "konsultanpendidikan",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".output/public"
  },
  "build": {
    "command": "npm run build"
  }
}
